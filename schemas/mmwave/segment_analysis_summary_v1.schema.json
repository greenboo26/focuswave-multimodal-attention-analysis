{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment_analysis_summary_v1.schema.json",
  "title": "FocusWave mmWave segment analysis summary v1",
  "type": "object",
  "required": [
    "schema_version", "pipeline_version", "analysis_id", "status", "method",
    "input_manifest", "preflight", "n_sessions", "n_segments_succeeded",
    "n_segments_failed", "records", "scientific_status"
  ],
  "properties": {
    "schema_version": {"const": "mmwave_segment_analysis_v1"},
    "pipeline_version": {"const": "v3.1.1-contract.1"},
    "status": {"enum": ["completed", "completed_with_failures"]},
    "method": {"enum": ["vmd_heart", "bp_heart"]},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session_id", "anonymous_participant_group_id", "segments"],
        "properties": {
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "schema_version", "pipeline_version", "analysis_id", "session_id",
                "anonymous_participant_group_id", "label", "frame_start", "frame_end",
                "method", "algorithm_returned", "quality_valid", "selection_status",
                "failure_reason", "heart_rate", "breath_rate", "hrv", "quality",
                "status_layers"
              ],
              "properties": {
                "schema_version": {"const": "mmwave_segment_analysis_v1"},
                "algorithm_returned": {"type": "boolean"},
                "quality_valid": {"type": "boolean"},
                "selection_status": {
                  "enum": ["selected", "rejected", "forced_candidate_unvalidated"]
                },
                "failure_reason": {"type": ["string", "null"]},
                "heart_rate": {"type": "object"},
                "breath_rate": {"type": "object"},
                "hrv": {"type": "object"},
                "quality": {
                  "type": "object",
                  "required": ["signal_quality", "metrics"]
                }
              }
            }
          }
        }
      }
    }
  }
}
